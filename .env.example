# Dead Drop — environment & secrets reference
#
# This file documents every variable the system needs. Copy the relevant values
# into the right place — secrets NEVER go in the repo:
#   - Local dev:  put secrets in `.dev.vars` (gitignored; see .dev.vars.example).
#   - Production: `npx wrangler secret put <NAME>` and set vars in wrangler.jsonc.
#   - CI deploy:  store CLOUDFLARE_* as GitHub Actions repository secrets.

# ── Server: Slack (consumer) ──────────────────────────────────────────────────
# Bot token for chat.postMessage. SECRET — set via `wrangler secret put` / .dev.vars.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Target private channel id (e.g. C0123456789). Non-secret; lives in wrangler.jsonc vars.
SLACK_CHANNEL_ID=C0123456789

# ── Server: app config (wrangler.jsonc vars) ─────────────────────────────────
# Browser origin allowed by CORS — the site, NOT the API hostname.
ALLOWED_ORIGIN=https://justanotherspy.com
# Hard global hourly ceiling (backstop against distributed floods).
GLOBAL_HOURLY_CEILING=400

# ── CI / deploy (GitHub Actions repository secrets) ──────────────────────────
# Cloudflare API token with Workers + Queues + KV deploy permissions. SECRET.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Cloudflare account id that owns the Worker.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ── Client (site build, separate repo/build step) ───────────────────────────
# Public ingest URL baked into the form at build time.
PUBLIC_DEADDROP_ENDPOINT=https://dead-drop.justanotherspy.com
